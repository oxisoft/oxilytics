# Copy to .env next to docker-compose.yml and fill in.

# --- required -------------------------------------------------------------
# 64 hex chars:  openssl rand -hex 32
OXI_SESSION_KEY=
# Public URL users open (https:// makes the session cookie Secure)
OXI_BASE_URL=https://analytics.example.com
# First admin, created only when the users table is empty
OXI_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
OXI_BOOTSTRAP_ADMIN_PASSWORD=change-me-at-least-10-chars

# --- optional -------------------------------------------------------------
OXI_TZ=UTC
OXI_LOG_LEVEL=info
OXI_BACKUP_KEEP=14

# --- App Store Connect (leave empty if not used) ---------------------------
# Put the .p8 file in ./secrets/AuthKey.p8
OXI_ASC_KEY_ID=
OXI_ASC_ISSUER_ID=

# --- Google Play (leave empty if not used) ---------------------------------
# Put the service-account JSON in ./secrets/gplay-sa.json
OXI_GPLAY_BUCKET=
